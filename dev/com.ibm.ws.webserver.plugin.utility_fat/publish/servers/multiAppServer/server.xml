<server description="Multi-app server for plugin generation batching test">

    <!-- Enable features -->
    <featureManager>
        <feature>servlet-3.1</feature>
    </featureManager>

    <!-- To access this server from a remote client add a host attribute to the following element, e.g. host="*" -->
    <include location="../fatTestPorts.xml"/>

    <!-- Three standalone WAR applications deployed at server start. These reproduce the
         original multiple-SRVE9103I issue: plugin config should be generated only once
         after the entire startup wave, not once per application. -->
    <application id="testApp1" name="testApp1" type="war" location="${server.config.dir}/apps/testApp1.war"/>
    <application id="testApp2" name="testApp2" type="war" location="${server.config.dir}/apps/testApp2.war"/>
    <application id="testApp3" name="testApp3" type="war" location="${server.config.dir}/apps/testApp3.war"/>

    <!-- A two-module EAR. Liberty fires one applicationStarting/applicationStarted pair
         for the EAR but two moduleStarting/moduleStarted pairs (one per web module).
         This verifies that module events do not introduce extra updatesInProgress tokens
         that would suppress or duplicate plugin generation. -->
    <application id="multiModuleEar" name="multiModuleEar" type="ear" location="${server.config.dir}/apps/multiModuleEar.ear"/>

</server>
